# Copy to .env beside pom.xml. Use KEY=value without quotes or export.
# Restart the backend after edits. Environment variables still take precedence.
DB_PASSWORD=linkhub_dev
APP_BASE_URL=http://localhost:8081
COOKIE_SECURE=false
REDIS_TIMEOUT=5s
REDIS_CONNECT_TIMEOUT=3s
# Spring Boot and Docker Compose both read this file when it is named .env.
# TOKEN_MAIL_KEY: Base64 of 32 random bytes, persistent across restarts/instances.
TOKEN_MAIL_KEY=
# OPS_TOKEN: random secret of at least 32 characters; empty disables metric access.
OPS_TOKEN=
MAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
